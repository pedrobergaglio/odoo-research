<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Heredar la vista de formulario de contacto para añadir nuestro campo -->
    <record id="view_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="vat" position="after">
                <field name="partner_type" widget="radio"/>
                <button name="update_partner_type" string="Actualizar Tipo" type="object" class="oe_highlight"/>
            </field>
        </field>
    </record>
    
    <!-- Vista de búsqueda personalizada -->
    <record id="view_res_partner_filter_cliente" model="ir.ui.view">
        <field name="name">res.partner.select.cliente</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Nombre"/>
                <field name="email" string="Email"/>
                <field name="phone" string="Teléfono"/>
                <filter string="Clientes" name="customers" domain="[('customer_rank','>',0)]"/>
                <filter string="Proveedores" name="suppliers" domain="[('supplier_rank','>',0)]"/>
                <filter string="Ambos" name="both" domain="[('customer_rank','>',0), ('supplier_rank','>',0)]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Tipo de Contacto" name="partner_type" context="{'group_by': 'partner_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción para mostrar clientes con filtro predeterminado -->
    <record id="action_clientes" model="ir.actions.act_window">
        <field name="name">Clientes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('customer_rank','>',0)]</field>
        <field name="context">{'search_default_customers': 1, 'default_customer_rank': 1}</field>
        <field name="search_view_id" ref="view_res_partner_filter_cliente"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo cliente
            </p>
        </field>
    </record>

    <!-- Menú principal de la app -->
    <menuitem id="menu_clientes_root" 
              name="Clientes" 
              sequence="10" 
              web_icon="mi_modulo_clientes,static/description/icon.png"/>
              
    <!-- Submenú para clientes -->
    <menuitem id="menu_clientes"
              name="Clientes"
              parent="menu_clientes_root"
              action="action_clientes"
              sequence="1"/>
</odoo>