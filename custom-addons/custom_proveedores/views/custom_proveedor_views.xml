<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de lista con cards para Proveedores -->
    <record id="view_custom_proveedor_tree" model="ir.ui.view">
        <field name="name">custom.proveedor.tree</field>
        <field name="model">custom.proveedor</field>
        <field name="arch" type="xml">
            <list string="Proveedores" create="1" delete="1" edit="0">
                <field name="name"/>
                <field name="category" invisible="1"/>
                <control>
                    <create string="Crear Proveedor" context="{'default_category': 'supplier'}"/>
                </control>
            </list>
        </field>
    </record>

    <!-- Vista Kanban con cards -->
    <record id="view_custom_proveedor_kanban" model="ir.ui.view">
        <field name="name">custom.proveedor.kanban</field>
        <field name="model">custom.proveedor</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category" class="o_kanban_mobile">
                <field name="name"/>
                <field name="category"/>
                <field name="image"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card">
                            <div class="oe_kanban_global_click">
                                <field name="image" widget="image" class="oe_kanban_image"/>
                                <div class="oe_kanban_details">
                                    <h3>
                                        <field name="name"/>
                                    </h3>
                                    <div>
                                        <strong>Categoría:</strong> <field name="category"/>
                                    </div>
                                    <div>
                                        <strong>Total Pedidos:</strong> <field name="total_amount_pedidos" widget="monetary"/>
                                    </div>
                                    <div>
                                        <strong>Total Servicios:</strong> <field name="total_amount_servicios" widget="monetary"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vista de formulario para Proveedores -->
    <record id="view_custom_proveedor_form" model="ir.ui.view">
        <field name="name">custom.proveedor.form</field>
        <field name="model">custom.proveedor</field>
        <field name="arch" type="xml">
            <form string="Proveedor">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category" required="1"/>
                            <field name="image" widget="image" class="oe_avatar"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="mobile"/>
                        </group>
                        <group>
                            <field name="website"/>
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="city"/>
                            <field name="state_id"/>
                            <field name="country_id"/>
                            <field name="zip"/>
                        </group>
                    </group>
                     <notebook>
                        <page string="Pedidos/Servicios">
                            <field name="pedido_ids" invisible="1"/>
                            <field name="servicio_ids" invisible="1"/>
                            <group>
                                <div class="o_form_label">Pedidos Activos</div>
                                <field name="pedido_ids">
                                    <list>
                                        <field name="name" readonly="1"/>
                                        <field name="date" readonly="1"/>
                                        <field name="amount_total" widget="monetary" readonly="1"/>
                                        <field name="state" readonly="1"/>
                                    </list>
                                </field>
                                <div class="o_form_label">Servicios Activos</div>
                                <field name="servicio_ids">
                                    <list>
                                        <field name="name" readonly="1"/>
                                        <field name="date_servicio" string="Fecha" readonly="1"/>
                                        <field name="amount_total" widget="monetary" readonly="1"/>
                                        <field name="state" readonly="1"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de búsqueda para filtrar por categoría -->
    <record id="view_custom_proveedor_search" model="ir.ui.view">
        <field name="name">custom.proveedor.search</field>
        <field name="model">custom.proveedor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Proveedores" name="supplier_filter" domain="[('category', '=', 'supplier')]"/>
                <filter string="Ambos" name="both_filter" domain="[('category', '=', 'both')]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Categoría" name="category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de ventana para Proveedores -->
    <record id="action_custom_proveedor" model="ir.actions.act_window">
        <field name="name">Proveedores</field>
        <field name="res_model">custom.proveedor</field>
        <field name="view_mode">kanban,form</field>
        <field name="domain">[('category', 'in', ('supplier','both'))]</field> 
        <field name="context">{'search_default_supplier_filter': 1}</field>
        <field name="views" eval="[
            [False, 'kanban'],
            [False, 'form']
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aquí puedes ver y gestionar tus proveedores. Haz clic en "Crear Proveedor" para agregar uno nuevo.
            </p>
        </field>
    </record>

    <!-- Menú para Proveedores -->
    <menuitem id="menu_custom_proveedor_root" name="Proveedores" sequence="20" action="action_custom_proveedor"/>
</odoo>