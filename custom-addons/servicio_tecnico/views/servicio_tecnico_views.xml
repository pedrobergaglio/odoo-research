<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de formulario para Servicios Técnicos -->
    <record id="view_servicio_form" model="ir.ui.view">
        <field name="name">servicio.servicio.form</field>
        <field name="model">servicio.servicio</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_terminar" string="Terminar" type="object" class="oe_highlight" invisible="state != 'confirmado'"/>
                    <button name="action_en_proceso" string="En proceso" type="object" class="oe_highlight" invisible="state != 'confirmado'"/>
                    <button name="action_cancelar" string="Cancelar" type="object" invisible="state not in ('confirmado', 'terminado')"/>
                    <field name="state" widget="statusbar" statusbar_visible="confirmado,terminado,en_proceso,cancelado"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="presupuesto_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="date" readonly="1"/>
                            <field name="date_servicio" readonly="state == 'confirmado'"/>
                        </group>
                        <group>
                            <field name="payment_method_id" readonly="1"/>
                            <field name="fecha_entrega_estimada"/>
                            <field name="direccion_entrega"/>
                            <field name="user_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Productos/Servicios">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="tax_id" widget="many2many_tags"/>
                                    <field name="price_subtotal" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_untaxed" widget="monetary"/>
                                <field name="amount_tax" widget="monetary"/>
                                <field name="amount_total" class="oe_subtotal_footer_separator" widget="monetary"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de lista para Servicios Técnicos -->
    <record id="view_servicio_tree" model="ir.ui.view">
        <field name="name">servicio.servicio.tree</field>
        <field name="model">servicio.servicio</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="presupuesto_id"/>
                <field name="partner_id"/>
                <field name="date_servicio"/>
                <field name="amount_total" sum="Total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Vista de búsqueda para Servicios Técnicos -->
    <record id="view_servicio_search" model="ir.ui.view">
        <field name="name">servicio.servicio.search</field>
        <field name="model">servicio.servicio</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter string="Confirmado" name="confirmado" domain="[('state', '=', 'confirmado')]"/>
                <filter string="Terminado" name="terminado" domain="[('state', '=', 'terminado')]"/>
                <filter string="Cancelado" name="cancelado" domain="[('state', '=', 'cancelado')]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Cliente" name="partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Fecha de Servicio" name="date_servicio" context="{'group_by': 'date_servicio'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de ventana para Servicios Técnicos -->
    <record id="action_servicio" model="ir.actions.act_window">
        <field name="name">Servicios Técnicos</field>
        <field name="res_model">servicio.servicio</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_confirmado': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aquí puedes ver y gestionar los servicios técnicos.
            </p>
        </field>
    </record>

    <!-- Menú para Servicios Técnicos -->
    <menuitem id="menu_servicio_root" name="Servicios Técnicos" sequence="10" action="action_servicio"/>
</odoo>