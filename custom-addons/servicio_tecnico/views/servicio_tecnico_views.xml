<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tipos de Servicio -->
    <record id="view_service_order_type_form" model="ir.ui.view">
        <field name="name">service.order.type.form</field>
        <field name="model">service.order.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_service_order_type_tree" model="ir.ui.view">
        <field name="name">service.order.type.tree</field>
        <field name="model">service.order.type</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_service_order_type" model="ir.actions.act_window">
        <field name="name">Tipos de Servicio</field>
        <field name="res_model">service.order.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Extensión de la vista de órdenes de venta -->
    <record id="view_sale_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="service_type_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="is_service" invisible="1"/>
            </field>
        </field>
    </record>

    <!-- Vista de servicios técnicos (órdenes filtradas por tipo Servicio Técnico) -->
    <record id="action_servicios_tecnicos" model="ir.actions.act_window">
        <field name="name">Servicios Técnicos</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form,calendar,pivot,graph,activity</field>
        <field name="domain">[('is_service', '=', True)]</field>
        <!--<field name="context">{'default_service_type_id': ref('servicio_tecnico.service_order_type_tecnico')}</field>-->
        <field name="context" eval="{'default_service_type_id': ref('servicio_tecnico.service_order_type_tecnico')}"/>        

        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer servicio técnico
            </p>
        </field>
    </record>

    <!-- Filtros predefinidos para las vistas -->
    <record id="view_sale_order_search_inherit" model="ir.ui.view">
        <field name="name">sale.order.search.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <filter name="my_sale_orders_filter" position="after">
                <filter string="Servicios Técnicos" name="filter_servicios" domain="[('is_service', '=', True)]"/>
            </filter>
        </field>
    </record>
</odoo>