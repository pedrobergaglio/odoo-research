<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Categoría de Presupuesto Vistas -->
    <record id="view_presupuesto_categoria_form" model="ir.ui.view">
        <field name="name">presupuesto.categoria.form</field>
        <field name="model">presupuesto.categoria</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_presupuesto_categoria_tree" model="ir.ui.view">
        <field name="name">presupuesto.categoria.tree</field>
        <field name="model">presupuesto.categoria</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="action_presupuesto_categoria" model="ir.actions.act_window">
        <field name="name">Categorías de Presupuesto</field>
        <field name="res_model">presupuesto.categoria</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Presupuesto Vistas -->
    <record id="view_presupuesto_form" model="ir.ui.view">
        <field name="name">presupuesto.presupuesto.form</field>
        <field name="model">presupuesto.presupuesto</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_presupuestar" string="Presupuestar" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_confirmar_pedido" string="Confirmar como Pedido" type="object" class="oe_highlight" invisible="state != 'presupuestado' or categoria_code != 'pedido'"/>
                    <button name="action_confirmar_servicio" string="Confirmar como Servicio" type="object" class="oe_highlight" invisible="state != 'presupuestado' or categoria_code != 'servicio'"/>
                    <button name="action_en_proceso" string="Iniciar Proceso" type="object" class="oe_highlight" invisible="state not in ('presupuesto_pedido', 'presupuesto_servicio')"/>
                    <button name="action_finalizar" string="Finalizar" type="object" class="oe_highlight" invisible="state != 'en_proceso'"/>
                    <button name="action_cancelar" string="Cancelar" type="object" invisible="state not in ('draft', 'presupuestado', 'presupuesto_pedido', 'presupuesto_servicio', 'en_proceso')"/>
                    <button name="action_draft" string="Volver a Borrador" type="object" invisible="state not in ('presupuestado', 'cancelado')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,presupuestado,presupuesto_pedido,presupuesto_servicio,en_proceso,finalizado"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="address"/>
                            <field name="payment_method_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="categoria_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="categoria_code" invisible="1"/>
                            <field name="user_id" options="{'no_create': True}"/>
                            <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Productos/Servicios">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="tax_id" widget="many2many_tags"/>
                                    <field name="price_subtotal" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_untaxed" widget="monetary"/>
                                <field name="amount_tax" widget="monetary"/>
                                <field name="amount_total" class="oe_subtotal_footer_separator" widget="monetary"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                
            </form>
        </field>
    </record>

    <record id="view_presupuesto_tree" model="ir.ui.view">
        <field name="name">presupuesto.presupuesto.tree</field>
        <field name="model">presupuesto.presupuesto</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-success="state in ('presupuestado', 'presupuesto_pedido', 'presupuesto_servicio')" decoration-warning="state == 'en_proceso'" decoration-danger="state == 'cancelado'" decoration-muted="state == 'finalizado'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="categoria_id"/>
                <field name="amount_total" sum="Total" />
                <field name="state"/>
                <field name="user_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_presupuesto_search" model="ir.ui.view">
        <field name="name">presupuesto.presupuesto.search</field>
        <field name="model">presupuesto.presupuesto</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="categoria_id"/>
                <filter string="Mis Presupuestos" name="my_presupuestos" domain="[('user_id', '=', uid)]"/>
                <filter string="Presupuestos de Pedidos" name="pedidos" domain="[('categoria_code', '=', 'pedido')]"/>
                <filter string="Presupuestos de Servicios" name="servicios" domain="[('categoria_code', '=', 'servicio')]"/>
                <separator/>
                <filter string="Borrador" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Presupuestado" name="presupuestado" domain="[('state', '=', 'presupuestado')]"/>
                <filter string="En Proceso" name="en_proceso" domain="[('state', '=', 'en_proceso')]"/>
                <filter string="Finalizado" name="finalizado" domain="[('state', '=', 'finalizado')]"/>
                <filter string="Cancelado" name="cancelado" domain="[('state', '=', 'cancelado')]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Cliente" name="partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Categoría" name="categoria" context="{'group_by': 'categoria_id'}"/>
                    <filter string="Estado" name="state" context="{'group_by': 'state'}"/>
                    <filter string="Fecha" name="date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_presupuesto" model="ir.actions.act_window">
        <field name="name">Presupuestos</field>
        <field name="res_model">presupuesto.presupuesto</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea un nuevo presupuesto
            </p>
        </field>
    </record>

    <menuitem id="menu_presupuesto_root" name="Presupuestos" sequence="10" action="action_presupuesto" />
    

    
    <menuitem id="menu_configuracion" name="Configuración" parent="menu_presupuesto_root" sequence="100"/>
    <menuitem id="menu_presupuesto_categoria" name="Categorías" parent="menu_configuracion" action="action_presupuesto_categoria" sequence="10"/>
</odoo>