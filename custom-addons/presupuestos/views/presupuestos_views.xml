<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Categorías de Presupuesto -->
    <record id="view_presupuesto_category_form" model="ir.ui.view">
        <field name="name">presupuesto.category.form</field>
        <field name="model">presupuesto.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                        <field name="type"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_presupuesto_category_tree" model="ir.ui.view">
        <field name="name">presupuesto.category.tree</field>
        <field name="model">presupuesto.category</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="type"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_presupuesto_category" model="ir.actions.act_window">
        <field name="name">Categorías de Presupuesto</field>
        <field name="res_model">presupuesto.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Extensión de la vista de órdenes de venta -->
    <record id="view_sale_order_form_inherit_presupuestos" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.presupuestos</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="presupuesto_category_id" options="{'no_create': True}"/>
                <field name="is_pedido_presupuesto" invisible="1"/>
                <field name="is_servicio_presupuesto" invisible="1"/>
            </field>
        </field>
    </record>

    <!-- Vista de todos los presupuestos -->
    <record id="action_presupuestos_all" model="ir.actions.act_window">
        <field name="name">Todos los Presupuestos</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form,calendar,pivot,graph,activity</field>
        <field name="domain">[('state', '=', 'draft')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer presupuesto
            </p>
        </field>
    </record>

    <!-- Vista de presupuestos de tipo Pedido -->
    <record id="action_presupuestos_pedidos" model="ir.actions.act_window">
        <field name="name">Presupuestos de Pedidos</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form,calendar,pivot,graph,activity</field>
        <field name="domain">[('state', '=', 'draft'), ('is_pedido_presupuesto', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer presupuesto de Pedido
            </p>
        </field>
    </record>

    <!-- Vista de presupuestos de tipo Servicio Técnico -->
    <record id="action_presupuestos_servicios" model="ir.actions.act_window">
        <field name="name">Presupuestos de Servicios Técnicos</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form,calendar,pivot,graph,activity</field>
        <field name="domain">[('state', '=', 'draft'), ('is_servicio_presupuesto', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer presupuesto de Servicio Técnico
            </p>
        </field>
    </record>

    <!-- Filtros predefinidos para las vistas -->
    <record id="view_sale_order_search_inherit_presupuestos" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.presupuestos</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <filter name="my_sale_orders_filter" position="after">
                <filter string="Presupuestos de Pedidos" name="filter_presupuesto_pedido" domain="[('is_pedido_presupuesto', '=', True)]"/>
                <filter string="Presupuestos de Servicios" name="filter_presupuesto_servicio" domain="[('is_servicio_presupuesto', '=', True)]"/>
            </filter>
        </field>
    </record>
</odoo>