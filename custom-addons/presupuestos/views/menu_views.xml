<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menú principal para la app de Presupuestos -->
    <menuitem id="menu_presupuestos_root" 
              name="Presupuestos"
              web_icon="presupuestos,static/description/icon.png"
              sequence="4"/>

    <!-- Submenús principales -->
    <menuitem id="menu_presupuestos"
              name="Presupuestos"
              parent="menu_presupuestos_root"
              sequence="10"/>

    <menuitem id="menu_presupuestos_configuracion"
              name="Configuración"
              parent="menu_presupuestos_root"
              sequence="100"
              groups="group_presupuestos_manager"/>

    <!-- Submenús para acciones -->
    <menuitem id="menu_presupuestos_all"
              name="Todos los Presupuestos"
              parent="menu_presupuestos"
              action="action_presupuestos_all"
              sequence="10"/>

    <menuitem id="menu_presupuestos_pedidos"
              name="Presupuestos de Pedidos"
              parent="menu_presupuestos"
              action="action_presupuestos_pedidos"
              sequence="20"/>

    <menuitem id="menu_presupuestos_servicios"
              name="Presupuestos de Servicios"
              parent="menu_presupuestos"
              action="action_presupuestos_servicios"
              sequence="30"/>

    <menuitem id="menu_presupuesto_categories"
              name="Categorías de Presupuesto"
              parent="menu_presupuestos_configuracion"
              action="action_presupuesto_category"
              sequence="10"/>

    <!-- Crear datos iniciales para las categorías de presupuesto -->
    <record id="presupuesto_category_pedido" model="presupuesto.category">
        <field name="name">Pedido</field>
        <field name="code">pedido</field>
        <field name="description">Presupuesto para pedido</field>
        <field name="type">pedido</field>
    </record>

    <record id="presupuesto_category_servicio" model="presupuesto.category">
        <field name="name">Servicio Técnico</field>
        <field name="code">servicio</field>
        <field name="description">Presupuesto para servicio técnico</field>
        <field name="type">servicio</field>
    </record>
</odoo>