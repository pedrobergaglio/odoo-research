<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_presupuestos_category" model="ir.module.category">
        <field name="name">Presupuestos</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_presupuestos_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="category_id" ref="module_presupuestos_category"/>
    </record>

    <record id="group_presupuestos_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="category_id" ref="module_presupuestos_category"/>
        <field name="implied_ids" eval="[(4, ref('group_presupuestos_user'))]"/>
    </record>
</odoo>