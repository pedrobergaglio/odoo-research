<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción para abrir el wizard -->
    <record id="action_price_update" model="ir.actions.act_window">
        <field name="name">Actualización de Precios por Categoría</field>
        <field name="res_model">price.update.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Vista form para el wizard -->
    <record id="view_price_update_form" model="ir.ui.view">
        <field name="name">price.update.wizard.form</field>
        <field name="model">price.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Actualización de Precios por Categoría">
                <p>Seleccione una categoria para aplicar el porcentaje y el porcentaje en cuestion.</p>
                <group>
                    <field name="category_id"/>
                    <field name="percentage"/>
                </group>
                <footer>
                    <button string="Actualizar Precios" name="action_update_prices" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Entrada de menú en Inventario -->
    <menuitem id="menu_price_update"
              name="Actualización de Precios"
              parent="stock.menu_stock_root"
              action="action_price_update"
              sequence="100"/>
</odoo>